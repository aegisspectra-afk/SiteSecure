# SITE SECURE V2 — environment names only. Never commit real values.
#
# Local development: point SUPABASE_* at http://127.0.0.1:54321 (demo keys from `supabase status`).
# Hosted project keys belong ONLY in .env.cloud.local (gitignored). Never put cloud URLs in
# .env / apps/*/.env / apps/*/.env.local — the API refuses remote hosts when APP_ENV is
# development/test unless SS_ALLOW_REMOTE_SUPABASE=1.

# --- Shared (new Supabase project, NOT V1) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# --- API only (apps/api). Never expose to web or mobile. Never commit real values. ---
SUPABASE_SERVICE_ROLE_KEY=
# Local disposable Postgres for workforce RLS / atomic workspace proofs (127.0.0.1:54322 only).
# SITESECURE_ISOLATED_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
API_PUBLIC_URL=http://localhost:8000
WEB_PUBLIC_URL=http://localhost:5173
APP_ENV=development
CORS_EXTRA_ORIGINS=

# Optional one-shot operator bootstrap (scripts/bootstrap_platform_admin.py).
# Never auto-applied at runtime. Prefer --user-id over email when possible.
# PLATFORM_ADMIN_BOOTSTRAP_EMAIL=

# --- Web (apps/web) — Vite prefix. Baked in at build time. ---
# Local: http://localhost:8000. Vercel production: public FastAPI origin only. Never localhost.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:8000
# Optional marketing WhatsApp (digits only, e.g. 972501234567). Empty hides the channel.
# VITE_MARKETING_WHATSAPP=

# --- Aegis SSP (apps/ssp) — same public Vite keys; optional Platform Home link. Port 5174. ---
# Never add SUPABASE_SERVICE_ROLE_KEY to the SSP app.
# VITE_PLATFORM_HOME_URL=http://localhost:5173/platform
# VITE_WEB_ORIGIN=http://localhost:5173

# --- Workforce Intelligence (apps/WorkForce) — same public Vite keys. Port 5175. ---
# Never add SUPABASE_SERVICE_ROLE_KEY to the WorkForce app. Never prefix it with VITE_.
# Local defaults only. Production WorkForce builds fail on missing/localhost values.
# Vercel WorkForce project also needs SITESECURE_VERCEL_APP=workforce (not a VITE_ var).
# VITE_PLATFORM_HOME_URL=http://localhost:5173/platform
# VITE_WORKFORCE_APP_URL=http://localhost:5175

# --- Mobile (apps/mobile) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_URL=http://localhost:8000
