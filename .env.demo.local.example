# DEMO-6 — copy to .env.demo.local and fill values. Never commit real secrets.
# Used by: apps/api/scripts/demo_workspace_seed.py / demo_workspace_reset.py

APP_ENV=demo

# Dedicated demo Supabase project (or local 127.0.0.1:54321)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public origins for the demo stack
API_PUBLIC_URL=https://YOUR-DEMO-API.onrender.com
WEB_PUBLIC_URL=https://YOUR-DEMO-WEB.vercel.app
CORS_EXTRA_ORIGINS=

# Shared password for demo.*@sitesecure.test users (fictional)
DEMO_PASSWORD=Demo-Pass-2026!

# Required only when SUPABASE_URL is a *.supabase.co host (dedicated demo project)
# DEMO_ALLOW_CLOUD=1

# Web build (apps/web) — also set these in the Vercel demo project
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=
