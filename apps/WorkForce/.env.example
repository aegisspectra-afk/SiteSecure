# Public Vite env for Workforce Intelligence only. Never add SERVICE_ROLE or other server secrets.
# Never put SUPABASE_SERVICE_ROLE_KEY in a VITE_ variable.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:8000

# Development default. Production WorkForce builds fail if this is missing or localhost.
VITE_PLATFORM_HOME_URL=http://localhost:5173/platform
