{
  "name": "site-secure",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/ssp",
    "apps/WorkForce",
    "packages/*"
  ],
  "scripts": {
    "web:dev": "npm run dev -w @site-secure/web",
    "web:build": "npm run build -w @site-secure/web",
    "web:test": "npm run test -w @site-secure/ui && npm run test -w @site-secure/web",
    "web:lint": "npm run lint -w @site-secure/ui && npm run lint -w @site-secure/web",
    "web:typecheck": "npm run typecheck -w @site-secure/ui && npm run typecheck -w @site-secure/web",
    "ssp:dev": "npm run dev -w @aegis/ssp",
    "ssp:build": "npm run build -w @aegis/ssp",
    "ssp:typecheck": "npm run typecheck -w @aegis/ssp",
    "ssp:smoke": "npm run smoke -w @aegis/ssp",
    "workforce:dev": "npm run dev -w @aegis/workforce",
    "workforce:build": "npm run build -w @aegis/workforce",
    "workforce:typecheck": "npm run typecheck -w @aegis/workforce",
    "workforce:test": "npm run test -w @aegis/workforce",
    "vercel:build": "node scripts/vercel-build.mjs",
    "db:seed-local-auth": "python apps/api/scripts/seed_local_pytest_auth.py"
  },
  "engines": {
    "node": ">=20"
  }
}
